{
    "manifest_version": 3,
    "name": "Job Tracker",
    "version": "1.0.0",
    "permissions":[
        "storage",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "https://script.google.com/*",
        "https://script.googleusercontent.com/*",
        "https://*.greenhouse.io/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkdaysite.com/*",
        "https://*.ashbyhq.com/*"
    ],
    "action": {
        "default_popup": "index.html"
    }
}