{
    "manifest_version": 3,
    "name": "Job Tracker",
    "version": "1.0.0",
    "permissions":[
        "storage",
        "activeTab"
    ],
    "host_permissions": [
        "https://script.google.com/*",
        "https://script.googleusercontent.com/*"
    ],
    "action": {
        "default_popup": "index.html"
    }
}